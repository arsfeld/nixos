+/* OSC 52: a program sets the clipboard. Writes only; a "?" payload asks for
+ * the clipboard's contents back and is never answered. */
+void
+Terminal::set_clipboard_from_osc(std::string_view targets,
+                                 std::string_view data) noexcept
+{
+        if (!widget() || data.empty() || data == "?")
+                return;
+
+        auto type = vte::platform::ClipboardType::CLIPBOARD;
+        if (!targets.empty() &&
+            targets.find('c') == targets.npos &&
+            targets.find_first_of("ps") != targets.npos)
+                type = vte::platform::ClipboardType::PRIMARY;
+
+        auto const encoded = std::string{data};
+        gsize len = 0;
+        auto decoded = g_base64_decode(encoded.c_str(), &len);
+        if (decoded && len > 0)
+                widget()->clipboard_set_text(type,
+                                             reinterpret_cast<char const*>(decoded),
+                                             len);
+        g_free(decoded);
+}
