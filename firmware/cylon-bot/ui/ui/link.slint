// The two status pages the command menu opens. Link: the board's own Wi-Fi signal, address and uptime, and whether
// the bridge and the creature's voice are up; the app refreshes `info` every 2 s while it is open. Power: the
// battery, laid out the same way, an icon and a big number over a few rows; the app reads it every 30 s
// (`battery::REFRESH`) and every 2 s while the page is open.
import { Theme, LinkInfo, Battery } from "theme.slint";

// One arc of the signal icon, a static Path in its own tight box (padded by 8 px for the round caps). Slint fits the
// viewbox into the element less the 10 px stroke, offset by half of it: a viewbox that is the box shrunk by 5 px on
// each side draws the arc one to one in screen coordinates.
component SignalArc inherits Path {
    in property <bool> lit;
    viewbox-x: self.x / 1px + 5;
    viewbox-y: self.y / 1px + 5;
    viewbox-width: self.width / 1px - 10;
    viewbox-height: self.height / 1px - 10;
    stroke: root.lit ? #ff2a1a : #ff2a1a2e;
    stroke-width: 10px;
    stroke-line-cap: round;
}

// Big text under a page's icon: the reading in Sora 26 and its unit in Sora 14, sizes the build already embeds.
component Reading inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;
    x: 0px;
    y: 212px;
    width: 466px;
    height: 36px;
    alignment: center;
    spacing: 6px;
    Text {
        text: root.value;
        color: Theme.text;
        font-family: "Sora";
        font-size: 26px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
    Text {
        text: root.unit;
        color: Theme.muted;
        font-family: "Sora";
        font-size: 14px;
        vertical-alignment: bottom;
    }
}

component Heading inherits Text {
    x: 0px;
    y: 60px;
    width: 466px;
    color: #ff6a5a;
    font-family: "JetBrains Mono";
    font-size: 11px;
    letter-spacing: 4px;
    horizontal-alignment: center;
}

component Label inherits Text {
    x: 0px;
    width: 110px;
    color: Theme.muted;
    font-family: "JetBrains Mono";
    font-size: 11px;
    letter-spacing: 2px;
    vertical-alignment: center;
}

component Value inherits Text {
    x: 110px;
    width: 180px;
    color: Theme.text;
    font-family: "JetBrains Mono";
    font-size: 13px;
    overflow: elide;
    vertical-alignment: center;
}

export component LinkPage inherits Rectangle {
    // rssi 0 means not associated: the reading shows "--".
    in property <LinkInfo> info;
    // The bridge connection, and whether the bridge has a voice pipeline.
    in property <bool> link;
    in property <bool> voice-available;

    Heading {
        text: "// LINK //";
    }

    // Four arcs, outermost first, lit from the inside by `bars` (`view::signal_bars`); the mockup's geometry.
    SignalArc {
        x: 105px;
        y: 92px;
        width: 256px;
        height: 66px;
        commands: "M 113 150 A 170 170 0 0 1 353 150";
        lit: root.info.bars >= 4;
    }
    SignalArc {
        x: 135px;
        y: 115px;
        width: 196px;
        height: 53px;
        commands: "M 143 160 A 128 128 0 0 1 323 160";
        lit: root.info.bars >= 3;
    }
    SignalArc {
        x: 165px;
        y: 137px;
        width: 136px;
        height: 41px;
        commands: "M 173 170 A 86 86 0 0 1 293 170";
        lit: root.info.bars >= 2;
    }
    SignalArc {
        x: 195px;
        y: 160px;
        width: 76px;
        height: 28px;
        commands: "M 203 180 A 44 44 0 0 1 263 180";
        lit: root.info.bars >= 1;
    }
    Rectangle {
        x: 226px;
        y: 189px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.info.rssi != 0 ? #ffb4a0 : #ff2a1a2e;
    }

    Reading {
        value: root.info.rssi != 0 ? root.info.rssi : "--";
        unit: "dBm";
    }

    Rectangle {
        x: 88px;
        y: 264px;
        width: 290px;
        height: 130px;
        Label {
            y: 0px;
            height: 22px;
            text: "NETWORK";
        }
        Value {
            y: 0px;
            height: 22px;
            text: root.info.ssid;
        }
        Label {
            y: 26px;
            height: 22px;
            text: "ADDRESS";
        }
        Value {
            y: 26px;
            height: 22px;
            text: root.info.address;
        }
        Label {
            y: 52px;
            height: 22px;
            text: "BRIDGE";
        }
        Value {
            y: 52px;
            height: 22px;
            text: root.link ? "LINKED" : "DOWN";
            color: root.link ? Theme.done : Theme.muted;
        }
        Label {
            y: 78px;
            height: 22px;
            text: "VOICE";
        }
        Value {
            y: 78px;
            height: 22px;
            // The voice goes through the bridge: with the bridge down it is offline whatever the last mood said.
            text: root.link && root.voice-available ? "ONLINE" : "OFFLINE";
            color: root.link && root.voice-available ? Theme.done : Theme.muted;
        }
        Label {
            y: 104px;
            height: 22px;
            text: "UPTIME";
        }
        Value {
            y: 104px;
            height: 22px;
            text: root.info.uptime;
        }
    }
}

// One of the battery icon's four cells, lit like the signal arcs.
component Cell inherits Rectangle {
    in property <bool> lit;
    y: 116px;
    width: 32px;
    height: 56px;
    border-radius: 3px;
    background: root.lit ? #ff2a1a : #ff2a1a2e;
}

export component PowerPage inherits Rectangle {
    in property <Battery> battery;
    // A battery to show: the outline is dim without one, as the signal dot is without an access point.
    property <bool> present: root.battery.number != "--";

    Heading {
        text: "// POWER //";
    }

    // The icon, in the space the signal arcs take on the link page: a body, four cells lit by `cells` and the
    // terminal nub. All static, so a new reading repaints only what it changes.
    Rectangle {
        x: 143px;
        y: 104px;
        width: 170px;
        height: 80px;
        border-radius: 12px;
        border-width: 6px;
        border-color: root.present ? #ff2a1a : #ff2a1a2e;
    }
    Rectangle {
        x: 315px;
        y: 126px;
        width: 12px;
        height: 36px;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        background: root.present ? #ff2a1a : #ff2a1a2e;
    }
    Cell {
        x: 155px;
        lit: root.battery.cells >= 1;
    }
    Cell {
        x: 193px;
        lit: root.battery.cells >= 2;
    }
    Cell {
        x: 231px;
        lit: root.battery.cells >= 3;
    }
    Cell {
        x: 269px;
        lit: root.battery.cells >= 4;
    }
    // Charging: a bolt over the cells, light on a black edge so it reads over lit and unlit cells alike.
    if root.battery.charging: Path {
        x: 198px;
        y: 114px;
        width: 60px;
        height: 60px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M13.5 2 L5 13.5 H11 L10 22 L19 10 H13 Z";
        fill: #ffb4a0;
        stroke: #000000;
        stroke-width: 4px;
        stroke-line-join: round;
    }

    Reading {
        value: root.battery.number;
        unit: "%";
    }

    Rectangle {
        x: 88px;
        y: 264px;
        width: 290px;
        height: 74px;
        Label {
            y: 0px;
            height: 22px;
            text: "SOURCE";
        }
        Value {
            y: 0px;
            height: 22px;
            text: root.battery.source;
        }
        Label {
            y: 26px;
            height: 22px;
            text: "STATE";
        }
        Value {
            y: 26px;
            height: 22px;
            text: root.battery.state;
            color: root.battery.low ? Theme.error : root.battery.charging ? Theme.done : Theme.text;
        }
        Label {
            y: 52px;
            height: 22px;
            text: "VOLTAGE";
        }
        Value {
            y: 52px;
            height: 22px;
            text: root.battery.voltage;
        }
    }
}
