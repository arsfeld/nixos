// A question from Claude, taking over the screen. The question stays pinned at the top; the options are a
// wheel below it, the same one as the session list. Done (multi-select only) and "on computer" (declines, so
// the terminal asks as usual) are the last rows of the wheel.
import { Theme, OptionRow } from "theme.slint";
import { WheelRow } from "wheel.slint";

// One round badge and a label.
component ChoiceRow inherits WheelRow {
    in property <string> badge;
    in property <string> label;
    in property <bool> selected: false;
    in property <color> accent: Theme.waiting;
    in property <bool> quiet: false;
    callback tapped();

    height: 64px;

    Rectangle {
        x: 0px;
        y: 4px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        border-width: 2px;
        border-color: root.accent;
        background: root.selected ? root.accent : #0a0d16;
        Text {
            text: root.badge;
            color: root.selected ? #000000 : root.accent;
            font-family: "Sora";
            font-weight: 600;
            font-size: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 70px;
        width: root.width - 70px;
        height: parent.height;
        text: root.label;
        color: root.quiet ? Theme.muted : Theme.text;
        font-family: "Sora";
        font-size: root.quiet ? 16px : 19px;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => {
            root.tapped();
        }
    }
}

export component QuestionPage inherits Rectangle {
    in property <string> source;
    in property <string> question;
    in property <[OptionRow]> options;
    in property <bool> multi;
    in property <bool> can-done;
    in property <float> wheel-r: 233;
    in property <float> inset: 66;
    callback option-tapped(int);
    callback done-tapped();
    callback decline-tapped();

    property <length> top: 156px;
    property <int> extras: root.multi ? 2 : 1;

    Text {
        y: 44px;
        width: 466px;
        text: root.source;
        color: Theme.waiting;
        font-family: "JetBrains Mono";
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        x: 83px;
        y: 62px;
        width: 300px;
        height: 90px;
        text: root.question;
        color: Theme.text;
        font-family: "Sora";
        font-weight: 600;
        font-size: 19px;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Rows are 64 px tall every 72 px, starting 6 px below the wheel's top; the wheel clips what scrolls under
    // the question.
    flick := Flickable {
        x: 0px;
        y: root.top;
        width: 466px;
        height: 466px - root.top;
        content-width: 466px;
        content-height: 12px + (root.options.length + root.extras) * 72px + 70px;
        for opt[i] in root.options: ChoiceRow {
            y: 6px + i * 72px;
            cy: root.top + flick.content-y + 6px + i * 72px + 32px;
            wheel-r: root.wheel-r;
            inset: root.inset;
            badge: i + 1;
            label: opt.label;
            selected: opt.selected;
            tapped => {
                root.option-tapped(i);
            }
        }
        if root.multi: ChoiceRow {
            y: 6px + root.options.length * 72px;
            cy: root.top + flick.content-y + 6px + root.options.length * 72px + 32px;
            wheel-r: root.wheel-r;
            inset: root.inset;
            badge: "OK";
            label: "Done";
            selected: root.can-done;
            accent: Theme.done;
            tapped => {
                root.done-tapped();
            }
        }
        ChoiceRow {
            y: 6px + (root.options.length + root.extras - 1) * 72px;
            cy: root.top + flick.content-y + 6px + (root.options.length + root.extras - 1) * 72px + 32px;
            wheel-r: root.wheel-r;
            inset: root.inset;
            badge: "PC";
            label: "On computer";
            accent: Theme.muted;
            quiet: true;
            tapped => {
                root.decline-tapped();
            }
        }
    }
}
