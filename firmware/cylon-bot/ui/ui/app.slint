// The whole screen: the rim around whichever page is up.
import { Theme, SessionState, PresenceState, RimSegment, Page, SessionRow, OptionRow, FeedKind, FeedRow, Tick, LinkInfo, Battery } from "theme.slint";
import { Rim } from "rim.slint";
import { HomePage } from "home.slint";
import { SessionsPage } from "sessions.slint";
import { QuestionPage } from "question.slint";
import { DetailPage } from "detail.slint";
import { VolumePage, PurgePage } from "commands.slint";
import { LinkPage } from "link.slint";
import { GlyphCoverage } from "glyphs.slint";
export { Theme, SessionState, PresenceState, RimSegment, Page, SessionRow, OptionRow, FeedKind, FeedRow, Tick, LinkInfo, Battery }

export component AppWindow inherits Window {
    width: 466px;
    height: 466px;
    background: Theme.bg;
    // A literal: the compiler embeds glyphs at build time and cannot resolve a property.
    default-font-family: "Sora";

    in property <Page> page: Page.home;
    in property <bool> link: false;
    in property <[RimSegment]> rim;
    in property <[RimSegment]> rim-pulsing;

    // Home.
    in property <PresenceState> presence-state: PresenceState.idle;
    in property <float> presence-level: 0;
    in property <string> summary;
    // False while the bridge says it has no voice pipeline.
    in property <bool> voice-available: true;
    // The last reply Claude spoke (empty: no card) and the words that prompted it.
    in property <string> reply-text;
    in property <string> reply-heading;
    // Speaker volume, 0 to 100, shown on home for a moment after a swipe up or down changes it.
    in property <int> volume: 80;
    in property <bool> volume-shown: false;
    // The command menu (a swipe down from the top edge opens it): its three arcs, Volume, Link and Purge, built once.
    in property <bool> menu-open: false;
    in property <[RimSegment]> commands;
    // The volume page's 24 ticks and the purge page's ring of 36, built once (`rim::ticks`).
    in property <[Tick]> volume-ticks;
    in property <[Tick]> ring-ticks;
    // How long the purge button must be held (the controller sets it from PURGE_HOLD_MS), and how far a hold has got.
    in property <duration> purge-hold: 1500ms;
    in-out property <float> purge-progress: 0;
    // A purge sent and not yet answered by the bridge: the purge button waits.
    in property <bool> purge-pending: false;
    // The link page's Wi-Fi reading, uptime included (the app sets it every 2 s while the page is open).
    in property <LinkInfo> link-info: { rssi: 0, bars: 0, ssid: "--", address: "--", uptime: "--" };
    // Read every 30 s (`battery::REFRESH`).
    in property <Battery> battery: { percent: 0, low: false, text: "--" };
    // List.
    in property <[SessionRow]> rows;
    in property <float> list-wheel-radius: 233;
    in property <float> list-inset: 66;
    // How far the list is scrolled; 0 shows the first row at the centre.
    in-out property <length> list-scroll: 0px;
    // Question.
    in property <string> question-source;
    in property <string> question-text;
    in property <[OptionRow]> options;
    in property <bool> multi;
    in property <bool> can-done;
    // Detail.
    in property <string> detail-host;
    in property <string> detail-project;
    in property <SessionState> detail-state;
    in property <string> detail-state-text;
    in property <string> detail-since;
    in property <[FeedRow]> feed;
    in property <bool> feed-empty: true;
    // The full text of the tapped feed row; empty when none is open.
    in property <string> expanded-text;

    callback option-tapped(int);
    callback done-tapped();
    callback decline-tapped();
    callback row-tapped(int);
    // The ring was tapped at this angle, in degrees clockwise from the top.
    callback rim-tapped(float);
    // Swiped right (the firmware calls this): up one level, from detail to the list and from the list to home.
    callback back-tapped();
    callback avatar-tapped();
    callback reply-tapped();
    callback entry-tapped(int);
    callback expanded-closed();
    // The volume page's - (false) or + (true).
    callback volume-step(bool);
    // The purge button was held to the end.
    callback purge-confirmed();

    // Everything moves together by a few pixels now and then, so an AMOLED panel never shows the same bright
    // pixels in the same place for days (see power::drift_px).
    in property <length> drift-x: 0px;
    in property <length> drift-y: 0px;
    // Where the ring's touch area begins, from the centre. While the menu is open it reaches in to 150, past the
    // command labels (about 160) to just outside the avatar's circle (140), so a tap on a label opens its command.
    property <float> ring-inner: root.menu-open ? 150 : 190;

    Rectangle {
        x: root.drift-x;
        y: root.drift-y;
        width: 466px;
        height: 466px;

        GlyphCoverage {}

        // The volume and purge pages draw their own ticks round the edge, where the session arcs would be.
        if root.page != Page.volume && root.page != Page.purge: Rim {
            width: 466px;
            height: 466px;
            segments: root.rim;
            pulsing: root.rim-pulsing;
        }

        // Taps on the ring itself (outside radius 190) open the session that arc stands for. While the menu is open
        // the ring reaches in to its labels (see ring-inner).
        ring := TouchArea {
            width: 466px;
            height: 466px;
            // The list fills the screen and takes its own touches.
        enabled: root.page == Page.home;
            // Offsets from the centre in pixels, y up.
            property <float> dx: (self.mouse-x - 233px) / 1px;
            property <float> dy: (233px - self.mouse-y) / 1px;
            clicked => {
                if (self.dx * self.dx + self.dy * self.dy > root.ring-inner * root.ring-inner) {
                    root.rim-tapped(Math.atan2(self.dx, self.dy) / 1deg);
                }
            }
        }

        if root.page == Page.home: HomePage {
            presence-state: root.presence-state;
            presence-level: root.presence-level;
            summary: root.summary;
            link: root.link;
            voice-available: root.voice-available;
            reply-text: root.reply-text;
            reply-heading: root.reply-heading;
            volume: root.volume;
            volume-shown: root.volume-shown;
            battery: root.battery;
            menu-open: root.menu-open;
            commands: root.commands;
            ring-inner: root.ring-inner;
            rim-tapped(deg) => {
                root.rim-tapped(deg);
            }
            avatar-tapped => {
                root.avatar-tapped();
            }
            reply-tapped => {
                root.reply-tapped();
            }
        }
        if root.page == Page.list: SessionsPage {
            rows: root.rows;
            wheel-r: root.list-wheel-radius;
            inset: root.list-inset;
            scroll <=> root.list-scroll;
            row-tapped(i) => {
                root.row-tapped(i);
            }
        }
        if root.page == Page.question: QuestionPage {
            source: root.question-source;
            question: root.question-text;
            options: root.options;
            multi: root.multi;
            can-done: root.can-done;
            option-tapped(i) => {
                root.option-tapped(i);
            }
            done-tapped => {
                root.done-tapped();
            }
            decline-tapped => {
                root.decline-tapped();
            }
        }
        if root.page == Page.volume: VolumePage {
            ticks: root.volume-ticks;
            volume: root.volume;
            volume-step(louder) => {
                root.volume-step(louder);
            }
        }
        if root.page == Page.link: LinkPage {
            info: root.link-info;
            battery: root.battery.text;
            link: root.link;
            voice-available: root.voice-available;
        }
        if root.page == Page.purge: PurgePage {
            ticks: root.ring-ticks;
            link: root.link;
            pending: root.purge-pending;
            hold-time: root.purge-hold;
            progress <=> root.purge-progress;
            purge-confirmed => {
                root.purge-confirmed();
            }
        }
        if root.page == Page.detail: DetailPage {
            host: root.detail-host;
            project: root.detail-project;
            state: root.detail-state;
            state-text: root.detail-state-text;
            since-text: root.detail-since;
            feed: root.feed;
            feed-empty: root.feed-empty;
            expanded-text: root.expanded-text;
            entry-tapped(i) => {
                root.entry-tapped(i);
            }
            expanded-closed => {
                root.expanded-closed();
            }
        }
    }
}
