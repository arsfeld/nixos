// The home page: the avatar in the middle of the rim and one line saying what needs attention.
import { Theme, PresenceState, RimSegment, SessionState, Battery } from "theme.slint";
import { Presence } from "presence.slint";

// One arc of the command menu: a metal band, a 50 px outline under a 46 px fill, in the arc's own tight box. The
// purge arc (its segment carries the error state) has a red edge, and is dimmed while it cannot be used.
component CommandArc inherits Rectangle {
    in property <RimSegment> seg;
    in property <bool> dim;
    property <bool> purge: seg.state == SessionState.error;
    x: seg.x;
    y: seg.y;
    width: seg.width;
    height: seg.height;
    // Slint fits the viewbox into the element shrunk by the stroke width (half on each side), so each Path is grown
    // by its stroke to map the viewbox onto the segment's box one to one. Their element boxes are therefore larger
    // than the segment's box (by the stroke), and a Path with an animated property repaints its whole box every
    // frame: keep both static. Never animate their stroke or geometry.
    Path {
        x: -25px;
        y: -25px;
        width: parent.width + 50px;
        height: parent.height + 50px;
        viewbox-x: seg.x / 1px;
        viewbox-y: seg.y / 1px;
        viewbox-width: seg.width / 1px;
        viewbox-height: seg.height / 1px;
        commands: seg.commands;
        stroke: !root.purge ? #5b606b : root.dim ? #ff2a1a50 : #ff2a1a;
        stroke-width: 50px;
    }
    Path {
        x: -23px;
        y: -23px;
        width: parent.width + 46px;
        height: parent.height + 46px;
        viewbox-x: seg.x / 1px;
        viewbox-y: seg.y / 1px;
        viewbox-width: seg.width / 1px;
        viewbox-height: seg.height / 1px;
        commands: seg.commands;
        stroke: root.purge ? #1a0c0b : #15171c;
        stroke-width: 46px;
    }
}

// A 36 px line icon on the menu, drawn from a 24-unit SVG path (scaled 1.5) with a 3.5 px line, so it reads on the
// panel at a glance (24 px with a 2 px line was a faint hairline). The element is the stroke larger than the icon,
// because Slint fits the viewbox into the element less the stroke: centre it on the icon's centre.
component CommandIcon inherits Path {
    in property <color> ink: #ff2a1a;
    in property <length> cx;
    in property <length> cy;
    x: root.cx - 19.75px;
    y: root.cy - 19.75px;
    width: 39.5px;
    height: 39.5px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.ink;
    stroke-width: 3.5px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component CommandLabel inherits Text {
    width: 80px;
    color: Theme.muted;
    font-family: "JetBrains Mono";
    font-size: 13px;
    letter-spacing: 2px;
    horizontal-alignment: center;
}

export component HomePage inherits Rectangle {
    in property <PresenceState> presence-state;
    in property <float> presence-level;
    in property <string> summary;
    in property <bool> link;
    in property <bool> voice-available: true;
    in property <string> reply-text;
    in property <string> reply-heading;
    in property <int> volume: 80;
    in property <bool> volume-shown: false;
    in property <Battery> battery: { percent: 0, low: false, cells: 0, charging: false, number: "--", source: "--", state: "--", voltage: "--" };
    in property <bool> menu-open: false;
    in property <[RimSegment]> commands;
    // Where the window's ring touch area begins, from the centre: taps beyond it on the avatar's box belong to the ring.
    in property <float> ring-inner: 190;
    callback avatar-tapped();
    callback reply-tapped();
    callback rim-tapped(float);

    // The command menu across the top of the rim: Volume, Link, Power and Purge, left to right. Its box is the top band
    // only, so opening and closing it repaints no more than that.
    if root.menu-open: Rectangle {
        // Explicit: an element with a size and no position is centred in its parent.
        x: 0px;
        y: 0px;
        width: 466px;
        height: 180px;
        for seg in root.commands: CommandArc {
            seg: seg;
            dim: !root.link;
        }
        // Volume: a solid speaker and two sound waves. The icons sit on the arcs' centre line (radius 200, at
        // -49.5, -16.5, 16.5 and 49.5 degrees), the labels inside them at radius 159.
        CommandIcon {
            cx: 81px;
            cy: 103px;
            commands: "M4 9v6h4l5 4V5L8 9H4z";
            fill: #ff2a1a;
        }
        CommandIcon {
            cx: 81px;
            cy: 103px;
            commands: "M16.5 8.5a5 5 0 0 1 0 7 M19 6a8.5 8.5 0 0 1 0 12";
        }
        // Link: three Wi-Fi arcs and a dot.
        CommandIcon {
            cx: 176px;
            cy: 41px;
            commands: "M2 9a15 15 0 0 1 20 0 M5.5 12.5a10 10 0 0 1 13 0 M9 16a5 5 0 0 1 6 0";
        }
        Rectangle {
            x: 173px;
            y: 50px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ff2a1a;
        }
        // Power: a battery, its terminal and a bar of charge.
        CommandIcon {
            cx: 290px;
            cy: 41px;
            commands: "M4 7h13a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z M22 10.5v3 M6 12h6";
        }
        // Purge: a counter-clockwise arrow round a bar.
        CommandIcon {
            cx: 385px;
            cy: 103px;
            commands: "M4 12a8 8 0 1 0 2.4-5.7 M4 4v5h5 M9 12h6";
            ink: root.link ? #ff2a1a : #ff2a1a50;
        }
        CommandLabel {
            x: 72px;
            y: 122px;
            text: "VOL " + root.volume;
        }
        CommandLabel {
            x: 148px;
            y: 73px;
            text: "LINK";
        }
        CommandLabel {
            x: 238px;
            y: 73px;
            text: "POWER";
        }
        CommandLabel {
            x: 305px;
            y: 122px;
            text: "PURGE";
            color: root.link ? #ff6a5a : #ff6a5a50;
        }
    }

    Presence {
        x: 93px;
        y: 93px;
        state: root.presence-state;
        level: root.presence-level;
        offline: !root.voice-available;
        TouchArea {
            // Offsets from the screen's centre in pixels, y up (this box starts at 93, 93).
            property <float> dx: (self.mouse-x - 140px) / 1px;
            property <float> dy: (140px - self.mouse-y) / 1px;
            clicked => {
                // With the menu open, the corners of this box overlap its arcs: a tap there is the ring's, not the
                // avatar's, and one between the two is nobody's.
                if (root.menu-open && self.dx * self.dx + self.dy * self.dy > 140 * 140) {
                    if (self.dx * self.dx + self.dy * self.dy > root.ring-inner * root.ring-inner) {
                        root.rim-tapped(Math.atan2(self.dx, self.dy) / 1deg);
                    }
                } else {
                    root.avatar-tapped();
                }
            }
        }
    }

    Text {
        y: 352px;
        width: 466px;
        // The reply card takes this place while it is up.
        visible: root.reply-text == "";
        text: root.summary;
        color: Theme.text;
        font-family: "Sora";
        font-size: 22px;
        horizontal-alignment: center;
    }

    if !root.link: Text {
        y: 394px;
        width: 466px;
        text: "OFFLINE";
        color: Theme.muted;
        font-family: "JetBrains Mono";
        font-size: 12px;
        horizontal-alignment: center;
    }

    if !root.voice-available: Text {
        y: 412px;
        width: 466px;
        text: "VOICE OFFLINE";
        color: Theme.muted;
        font-family: "JetBrains Mono";
        font-size: 12px;
        horizontal-alignment: center;
    }

    // The last reply, under the avatar. It sits inside the round screen: 246 px wide at y 310 to 402, clear of the rim.
    if root.reply-text != "": Rectangle {
        x: 110px;
        y: 310px;
        width: 246px;
        height: 92px;
        border-radius: 20px;
        background: #141a2b;
        border-width: 1px;
        border-color: #2a3350;
        clip: true;
        TouchArea {
            clicked => {
                root.reply-tapped();
            }
        }
        Text {
            x: 12px;
            y: 7px;
            width: 222px;
            text: root.reply-heading;
            color: Theme.muted;
            font-family: "JetBrains Mono";
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
        }
        Text {
            x: 12px;
            y: 24px;
            width: 222px;
            height: 64px;
            text: root.reply-text;
            color: Theme.text;
            font-family: "Sora";
            font-size: 15px;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // A low battery, above the avatar where the volume pill shows (inside the rim, clear of the avatar's box), and out
    // of the way while that pill or the command menu is up. Static: it repaints only when a reading changes it.
    if root.battery.low && !root.volume-shown && !root.menu-open: Rectangle {
        x: 199px;
        y: 54px;
        width: 68px;
        height: 18px;
        // The body, its fill to the charge, and the terminal nub.
        Rectangle {
            x: 0px;
            y: 2px;
            width: 26px;
            height: 14px;
            border-radius: 3px;
            border-width: 2px;
            border-color: Theme.error;
        }
        Rectangle {
            x: 4px;
            y: 6px;
            width: max(2px, 18px * root.battery.percent / 100);
            height: 6px;
            background: Theme.error;
        }
        Rectangle {
            x: 27px;
            y: 6px;
            width: 3px;
            height: 6px;
            background: Theme.error;
        }
        Text {
            x: 36px;
            width: 32px;
            height: 18px;
            text: root.battery.percent + "%";
            color: Theme.error;
            font-family: "JetBrains Mono";
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    // The volume, for a moment after a swipe changed it: above the avatar, inside the rim.
    if root.volume-shown: Rectangle {
        x: 143px;
        y: 44px;
        width: 180px;
        height: 40px;
        border-radius: 20px;
        background: #15171c;
        border-width: 1px;
        border-color: #3a3f4a;
        Text {
            x: 16px;
            width: 70px;
            height: 40px;
            text: "VOLUME";
            color: Theme.muted;
            font-family: "JetBrains Mono";
            font-size: 11px;
            vertical-alignment: center;
        }
        // Ten ticks, lit up to the level (10 to 100) as on the volume page, the last lit one brighter.
        property <int> lit: Math.round(root.volume / 10);
        for i in 10: Rectangle {
            x: 76px + i * 9px;
            y: 12px;
            width: 4px;
            height: 16px;
            border-radius: 1px;
            background: i >= parent.lit ? #1f2128 : (i == parent.lit - 1 ? #ffb4a0 : #ff2a1a);
        }
    }
}
