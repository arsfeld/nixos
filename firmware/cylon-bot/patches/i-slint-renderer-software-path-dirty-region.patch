+// Local patch (cylon-bot, firmware/cylon-bot/patches): the mask is rendered once and blended only over the
+// spans of the frame's dirty region (`RenderToBuffer::foreach_ranges`), as every other primitive is. Upstream
+// 1.18.1 blended it over the whole item clip, so with a reused buffer a Path repainted outside the dirty region and
+// covered whatever was drawn above it there, which that frame did not repaint.
+
+/// The style for a filled path.
+pub fn fill_style() -> Style<'static> {
+    Style::Fill(Fill::NonZero)
