+impl<B: target_pixel_buffer::TargetPixelBuffer> RenderToBuffer<'_, B> {
+    /// Local patch (see path.rs): render the mask once, blend it only where the dirty region and the clip meet.
+    #[cfg(feature = "path")]
+    fn blend_path(
+        &mut self,
+        path_geometry: &PhysicalRect,
+        clip_geometry: &PhysicalRect,
+        commands: &[path::Command],
+        color: PremultipliedRgbaColor,
+        style: zeno::Style<'_>,
+    ) {
+        let Some(mask) = path::render_mask(commands, path_geometry, style) else { return };
+        let x0 = clip_geometry.origin.x;
+        self.foreach_ranges(clip_geometry, |line, span, extra_left_clip, _| {
+            path::blend_mask_span(&mask, path_geometry, color, line, x0 + extra_left_clip, span)
+        });
     }
 }
 
