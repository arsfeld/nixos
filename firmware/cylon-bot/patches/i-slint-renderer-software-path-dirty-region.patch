+/// The path's coverage, one byte a pixel over the whole `path_geometry`; `None` for an empty geometry.
+pub fn render_mask(commands: &[Command], path_geometry: &PhysicalRect, style: Style<'_>) -> Option<Vec<u8>> {
+    let path_width = path_geometry.size.width as usize;
+    let path_height = path_geometry.size.height as usize;
+    if path_width == 0 || path_height == 0 {
+        return None;
+    }
+    let mut mask_buffer = vec![0u8; path_width * path_height];
+    Mask::new(commands)
+        .size(path_width as u32, path_height as u32)
+        .style(style)
+        .render_into(&mut mask_buffer, None);
+    Some(mask_buffer)
+}
+
+/// Blend `color` by the mask's coverage into `span`, the pixels of screen line `screen_y` starting at `screen_x`.
+pub fn blend_mask_span<T: TargetPixel>(
+    mask: &[u8],
+    path_geometry: &PhysicalRect,
+    color: PremultipliedRgbaColor,
+    screen_y: i16,
+    screen_x: i16,
+    span: &mut [T],
+) {
+    let path_width = path_geometry.size.width as isize;
+    let path_height = path_geometry.size.height as isize;
+    let mask_y = screen_y as isize - path_geometry.origin.y as isize;
+    if mask_y < 0 || mask_y >= path_height {
+        return;
+    }
+    for (i, pixel) in span.iter_mut().enumerate() {
+        let mask_x = screen_x as isize + i as isize - path_geometry.origin.x as isize;
+        if mask_x < 0 || mask_x >= path_width {
+            continue;
+        }
+        let coverage = mask[(mask_y * path_width + mask_x) as usize];
+        if coverage > 0 {
+            // Scale all color components by coverage to maintain premultiplication
+            let coverage_factor = coverage as u16;
+            let alpha_color = PremultipliedRgbaColor {
+                red: ((color.red as u16 * coverage_factor) / 255) as u8,
+                green: ((color.green as u16 * coverage_factor) / 255) as u8,
+                blue: ((color.blue as u16 * coverage_factor) / 255) as u8,
+                alpha: ((color.alpha as u16 * coverage_factor) / 255) as u8,
+            };
+            T::blend(pixel, alpha_color);
+        }
+    }
 }
