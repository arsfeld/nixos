# Settings for the ESP-IDF build that esp-idf-sys runs (the C firmware's version of this file, with its LVGL
# lines, is gone). Internal RAM and DMA are the scarce things; see CLAUDE.md.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The UI runs on the main task. Rasterizing one stroked Slint Path (zeno) takes about 37 KB of stack, two frames
# of fixed on-stack arrays; at 16 KB the first arc overflowed into the heap and the next malloc hung until the
# interrupt watchdog fired. 48 KB leaves ~11 KB of headroom; the heap line logs ui_stack_min_free.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=49152
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# TLS to the bridge: validate against the full certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Internal RAM is scarce: mbedTLS and Wi-Fi/lwIP buffers prefer PSRAM, small allocations too, and a
# 64 KB internal pool is kept for DMA (the display driver needs contiguous internal blocks).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set



# esp-idf-hal links the legacy I2C driver; this code uses the new one and never starts the legacy one.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
