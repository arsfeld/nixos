# Waveshare ESP32-S3-Touch-AMOLED-1.75: 8 MB octal PSRAM, QIO flash. The 1.75C reports 32 MB of
# flash, the other variants 16 MB; the image and partition table fit either, so it is built
# for 16 MB.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# LVGL 9 (managed component), as Waveshare's own example configures it.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# TLS to the bridge: validate against the full certificate bundle (Cloudflare's chain included).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_SNAPSHOT=y

# Internal RAM is scarce (about 180 KB free after boot) and the UI, Wi-Fi and TLS all want it:
# mbedtls_ssl_setup failed with ALLOC_FAILED and the display driver with ESP_ERR_NO_MEM. The board
# has 8 MB of PSRAM, so let mbedTLS and the Wi-Fi/lwIP buffers prefer it.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The BSP draws in 50-row strips (466 x 50 x 2 = 46 KB) from PSRAM, and the SPI driver bounces each
# strip through one contiguous block of internal DMA RAM. Without this the display fails with
# "setup_dma_priv_buffer: Failed to allocate priv TX buffer" as soon as Wi-Fi and TLS have taken
# their share: reserve a pool that only DMA/internal allocations can use, larger than a strip.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Free more internal RAM: small allocations may live in PSRAM, and none of the IRAM speed-ups
# for Wi-Fi, lwIP or LVGL are needed for a status board.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
