// The pages the command menu on home opens. Placeholders for now: each shows its title.
import { Theme } from "theme.slint";

component CommandTitle inherits Rectangle {
    in property <string> title;
    Text {
        y: 140px;
        width: 466px;
        text: root.title;
        color: Theme.muted;
        font-family: "JetBrains Mono";
        font-size: 14px;
        letter-spacing: 3px;
        horizontal-alignment: center;
    }
}

export component VolumePage inherits Rectangle {
    CommandTitle {
        title: "AUDIO LEVEL";
    }
}

export component LinkPage inherits Rectangle {
    CommandTitle {
        title: "LINK";
    }
}

export component PurgePage inherits Rectangle {
    CommandTitle {
        title: "PURGE";
    }
}
