// The session list as a fan-out wheel: the row at the vertical centre sits furthest left and brightest, and
// rows above and below curve away to the right, narrow and fade, as on a round watch. Scrolled by touch.
//
// The software renderer cannot rotate items, so rows slide and fade along the curve but never tilt. Colours
// carry the fade (with-alpha) instead of `opacity`, which would render each row through an off-screen layer.
import { Theme, SessionRow } from "theme.slint";
import { Pill } from "widgets.slint";

component RowView inherits Rectangle {
    in property <SessionRow> data;
    // Where the row's centre is on the screen, supplied by the wheel.
    in property <length> cy;
    // The wheel: its radius (a bigger wheel bends less) and how far in from the screen edge the badges start.
    in property <float> wheel-r: 150;
    in property <float> inset: 28;
    callback tapped();

    // Distance from the screen centre. The row's left edge follows a circle of radius 190 (`bow` is how far
    // that circle has curved away from its widest point), and the right edge mirrors it.
    property <float> dy: (root.cy - 233px) / 1px;
    property <float> bow: root.wheel-r - Math.sqrt(Math.max(0, root.wheel-r * root.wheel-r - root.dy * root.dy));
    property <float> left: root.inset + root.bow;
    property <float> fade: Math.max(0, 1 - 0.7 * Math.min(1, Math.abs(root.dy) / 175));
    property <bool> centred: Math.abs(root.dy) < 30;

    x: root.left * 1px;
    width: Math.max(0, 466 - 2 * root.left) * 1px;
    height: 52px;
    visible: root.width > 60px;
    border-radius: 26px;
    background: root.data.waiting ? #1a1305.with-alpha(root.fade) : (root.centred ? #121a2e : #00000000);

    Rectangle {
        x: 10px;
        y: 8px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: Theme.session-color(root.data.state).with-alpha(root.fade);
        Text {
            text: root.data.initial;
            color: #000000;
            font-family: "Sora";
            font-weight: 600;
            font-size: 17px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 56px;
        y: 7px;
        width: root.width - 56px - 58px;
        text: root.data.project;
        color: Theme.text.with-alpha(root.fade);
        font-family: "Sora";
        font-weight: 600;
        font-size: root.centred ? 20px : 17px;
        overflow: elide;
    }
    Text {
        x: 56px;
        y: 32px;
        width: root.width - 56px - 58px;
        text: root.data.host;
        color: Theme.muted.with-alpha(root.fade);
        font-family: "JetBrains Mono";
        font-size: 11px;
        overflow: elide;
    }
    Text {
        x: root.width - 62px;
        width: 50px;
        height: parent.height;
        text: root.data.ago;
        color: Theme.muted.with-alpha(root.fade);
        font-family: "JetBrains Mono";
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    area := TouchArea {
        clicked => {
            root.tapped();
        }
    }
}

export component SessionsPage inherits Rectangle {
    in property <[SessionRow]> rows;
    in property <string> header;
    in property <float> wheel-r: 150;
    in property <float> inset: 28;
    // How far the list is scrolled (0, or negative).
    in-out property <length> scroll <=> flick.content-y;
    callback row-tapped(int);
    callback back-tapped();

    Text {
        y: 62px;
        width: 466px;
        text: root.header;
        color: Theme.muted;
        font-family: "JetBrains Mono";
        font-size: 12px;
        horizontal-alignment: center;
    }

    // Rows are 52 px tall every 56 px. 118 px of padding above and below lets the first and the last row
    // reach the centre: with the window at y 87 and 292 px tall, the first row's centre is at y 231.
    flick := Flickable {
        x: 0px;
        y: 87px;
        width: 466px;
        height: 292px;
        content-width: 466px;
        content-height: 2 * 118px + root.rows.length * 56px;
        for row[i] in root.rows: RowView {
            y: 118px + i * 56px;
            cy: 87px + flick.content-y + 118px + i * 56px + 26px;
            data: row;
            wheel-r: root.wheel-r;
            inset: root.inset;
            tapped => {
                root.row-tapped(i);
            }
        }
    }

    Pill {
        x: (466px - 120px) / 2;
        y: 388px;
        width: 120px;
        height: 38px;
        text: "Back";
        tapped => {
            root.back-tapped();
        }
    }
}
