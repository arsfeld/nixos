// The session list as a wheel, like a round watch's app list: big round badges down the left, each with
// its name, and the column curving away to the right above and below the centre row, following the screen's
// own curve. Rows at the top and bottom are half hidden by the bezel. Scrolled by touch.
//
// The software renderer cannot rotate items, so rows slide along the curve but never tilt.
import { Theme, SessionRow } from "theme.slint";
import { Pill } from "widgets.slint";

component RowView inherits Rectangle {
    in property <SessionRow> data;
    // Where the row's centre is on the screen, supplied by the wheel.
    in property <length> cy;
    // The wheel: its radius (the screen's own, so the column follows the bezel) and how far in from the screen
    // edge the badges start on the centre row.
    in property <float> wheel-r: 233;
    in property <float> inset: 66;
    callback tapped();

    // `bow` is how far the circle has curved away from its widest point at this distance from the centre.
    property <float> dy: (root.cy - 233px) / 1px;
    property <float> bow: root.wheel-r - Math.sqrt(Math.max(0, root.wheel-r * root.wheel-r - root.dy * root.dy));
    property <float> left: root.inset + root.bow;

    x: root.left * 1px;
    width: Math.max(0, 466 - root.left - 14) * 1px;
    height: 96px;
    visible: root.width > 40px;

    // The badge: the state's colour with the project's first letter.
    Rectangle {
        x: 0px;
        y: 6px;
        width: 84px;
        height: 84px;
        border-radius: 42px;
        background: Theme.session-color(root.data.state);
        Text {
            text: root.data.initial;
            color: #000000;
            font-family: "Sora";
            font-weight: 600;
            font-size: 26px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        x: 98px;
        width: root.width - 98px;
        height: parent.height;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.data.project;
            color: Theme.text;
            font-family: "Sora";
            font-weight: 600;
            font-size: 22px;
            wrap: word-wrap;
            overflow: elide;
        }
        Text {
            text: root.data.host + "  " + root.data.ago;
            color: Theme.muted;
            font-family: "JetBrains Mono";
            font-size: 12px;
            overflow: elide;
        }
    }
    area := TouchArea {
        clicked => {
            root.tapped();
        }
    }
}

export component SessionsPage inherits Rectangle {
    in property <[SessionRow]> rows;
    in property <float> wheel-r: 233;
    in property <float> inset: 66;
    // How far the list is scrolled (0, or negative). At 0 the first row is one slot above the centre, so the
    // list fills the screen from the top.
    in-out property <length> scroll <=> flick.content-y;
    callback row-tapped(int);
    callback back-tapped();

    // The whole screen scrolls, so rows can reach the bezel. Rows are 96 px tall every 104 px; the first row's
    // centre is at 81 + 48 = 129, and the last row can be scrolled up to the screen centre (233).
    flick := Flickable {
        x: 0px;
        y: 0px;
        width: 466px;
        height: 466px;
        content-width: 466px;
        content-height: Math.max(466px, 258px + root.rows.length * 104px);
        for row[i] in root.rows: RowView {
            y: 81px + i * 104px;
            cy: flick.content-y + 81px + i * 104px + 48px;
            data: row;
            wheel-r: root.wheel-r;
            inset: root.inset;
            tapped => {
                root.row-tapped(i);
            }
        }
    }

    Pill {
        x: (466px - 100px) / 2;
        y: 414px;
        width: 100px;
        height: 34px;
        text: "Back";
        tapped => {
            root.back-tapped();
        }
    }
}
