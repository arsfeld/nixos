// One session: where it runs, what state it is in, and (later) what it has been doing.
import { Theme, SessionState, FeedRow } from "theme.slint";

export component DetailPage inherits Rectangle {
    in property <string> host;
    in property <string> project;
    in property <SessionState> state;
    in property <string> state-text;
    in property <string> since-text;
    in property <[FeedRow]> feed;
    in property <bool> feed-empty;
    in property <string> expanded-text;
    callback entry-tapped(int);
    callback expanded-closed();

    Text {
        y: 58px;
        width: 466px;
        text: root.host;
        color: Theme.muted;
        font-family: "JetBrains Mono";
        font-size: 12px;
        horizontal-alignment: center;
    }
    Text {
        x: 83px;
        y: 78px;
        width: 300px;
        text: root.project;
        color: Theme.text;
        font-family: "Sora";
        font-weight: 600;
        font-size: 26px;
        horizontal-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: (466px - 200px) / 2;
        y: 124px;
        width: 200px;
        height: 30px;
        border-radius: 15px;
        background: Theme.session-color(root.state).with-alpha(0.2);
        Text {
            text: root.state-text + "  ·  " + root.since-text;
            color: Theme.session-color(root.state);
            font-family: "JetBrains Mono";
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Placeholder until the feed is drawn.
    Text {
        x: 83px;
        y: 170px;
        width: 300px;
        text: root.feed-empty ? "No activity yet" : root.expanded-text;
        color: Theme.muted;
        font-family: "Sora";
        font-size: 16px;
        horizontal-alignment: center;
    }
}
