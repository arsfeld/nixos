// One session: where it runs, what state it is in, and (later) what it has been doing.
import { Theme, SessionState, FeedKind, FeedRow } from "theme.slint";

export component DetailPage inherits Rectangle {
    in property <string> host;
    in property <string> project;
    in property <SessionState> state;
    in property <string> state-text;
    in property <string> since-text;
    in property <[FeedRow]> feed;
    in property <bool> feed-empty;
    in property <string> expanded-text;
    callback entry-tapped(int);
    callback expanded-closed();

    Text {
        y: 58px;
        width: 466px;
        text: root.host;
        color: Theme.muted;
        font-family: "JetBrains Mono";
        font-size: 12px;
        horizontal-alignment: center;
    }
    Text {
        x: 83px;
        y: 78px;
        width: 300px;
        text: root.project;
        color: Theme.text;
        font-family: "Sora";
        font-weight: 600;
        font-size: 26px;
        horizontal-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: (466px - 200px) / 2;
        y: 124px;
        width: 200px;
        height: 30px;
        border-radius: 15px;
        background: Theme.session-color(root.state).with-alpha(0.2);
        Text {
            text: root.state-text + "  ·  " + root.since-text;
            color: Theme.session-color(root.state);
            font-family: "JetBrains Mono";
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // True while the feed sticks to its newest (bottom) row; a flick up lets go, and flicking back to the
    // bottom takes hold again.
    property <bool> follow: true;

    if root.feed-empty: Text {
        x: 83px;
        y: 200px;
        width: 300px;
        text: "No activity yet";
        color: Theme.muted;
        font-family: "Sora";
        font-size: 16px;
        horizontal-alignment: center;
    }

    // The column is 300 px wide and ends at y 390, where the round edge is still 160 px from the centre line.
    feed-view := Flickable {
        x: 83px;
        y: 164px;
        width: 300px;
        height: 226px;
        content-width: 300px;
        content-height: column.preferred-height;
        flicked => {
            root.follow = self.content-y <= self.height - self.content-height + 4px;
        }
        changed content-height => {
            if root.follow {
                self.content-y = min(0px, self.height - self.content-height);
            }
        }

        column := VerticalLayout {
            y: 0px;
            width: 300px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;

            for row[i] in root.feed: Rectangle {
                // A Rectangle has no height of its own, so it takes its text's (a wrapped Text's preferred
                // height already honours max-lines).
                height: row.kind == FeedKind.prompt ? prompt-text.preferred-height : row.kind == FeedKind.tool ? 16px : reply-text.preferred-height;
                TouchArea {
                    clicked => {
                        root.entry-tapped(i);
                    }
                }

                prompt-text := Text {
                    visible: row.kind == FeedKind.prompt;
                    width: 100%;
                    text: row.text;
                    color: Theme.text;
                    font-family: "Sora";
                    font-weight: 600;
                    font-size: 15px;
                    wrap: word-wrap;
                    max-lines: 3;
                    overflow: elide;
                }
                HorizontalLayout {
                    visible: row.kind == FeedKind.tool;
                    spacing: 6px;
                    Rectangle {
                        width: 3px;
                        background: row.failed ? Theme.error : transparent;
                        border-radius: 1.5px;
                    }
                    Text {
                        text: row.text;
                        color: Theme.muted;
                        font-family: "JetBrains Mono";
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                reply-text := Text {
                    visible: row.kind == FeedKind.reply;
                    width: 100%;
                    text: row.text;
                    color: Theme.text.with-alpha(0.85);
                    font-family: "Sora";
                    font-size: 14px;
                    wrap: word-wrap;
                    max-lines: 5;
                    overflow: elide;
                }
            }
        }
    }

    // The whole text of one entry, over everything; a tap anywhere closes it.
    if root.expanded-text != "": Rectangle {
        width: 466px;
        height: 466px;
        background: Theme.bg;
        // The Flickable fills the page and the close TouchArea lives inside its content, so a drag scrolls
        // (the Flickable takes the pointer once it moves) and a plain tap still closes.
        Flickable {
            width: 466px;
            height: 466px;
            content-width: 466px;
            content-height: max(466px, full.y + full.preferred-height + 80px);
            TouchArea {
                width: 466px;
                height: parent.content-height;
                clicked => {
                    root.expanded-closed();
                }
            }
            full := Text {
                x: 83px;
                y: 70px;
                width: 300px;
                text: root.expanded-text;
                color: Theme.text;
                font-family: "Sora";
                font-size: 15px;
                wrap: word-wrap;
            }
        }
    }
}
