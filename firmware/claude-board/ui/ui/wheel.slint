// One row of a wheel, like a round watch's app list: the column curves away to the right above and below the
// centre row, following the screen's own curve. Shared by the session list and the question's options.
// The caller sets `cy` (the row's centre on the screen) and puts the row's content inside.
//
// The software renderer cannot rotate items, so rows slide along the curve but never tilt.
export component WheelRow inherits Rectangle {
    // Where the row's centre is on the screen, supplied by the wheel.
    in property <length> cy;
    // The wheel: its radius (the screen's own, so the column follows the bezel) and how far in from the screen
    // edge the content starts on the centre row.
    in property <float> wheel-r: 233;
    in property <float> inset: 66;

    // The most a row ever bows to the right, however far from the centre it is.
    in property <float> max-bow: 64;

    // `bow` is how far the column has curved away from its widest point at this distance from the centre.
    // It is a circle of the screen's radius near the centre (`dy^2 / 2R`, so the rows follow the bezel) that
    // eases off toward `max-bow` and never overshoots it: the slope falls smoothly to zero, so a row leaving
    // the screen straightens out gradually instead of swinging off to the right (a plain circle would put it
    // 128 px out by the time it is half hidden) or kinking where a hard cap would start.
    property <float> dy: (root.cy - root.wheel-r * 1px) / 1px;
    property <float> bow: root.max-bow * (1 - Math.exp(-(root.dy * root.dy) / (2 * root.wheel-r * root.max-bow)));
    property <float> left: root.inset + root.bow;

    x: root.left * 1px;
    width: Math.max(0, 2 * root.wheel-r - root.left - 14) * 1px;
    visible: root.width > 40px;
}
