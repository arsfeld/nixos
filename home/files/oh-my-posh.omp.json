{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "purple": "#9A348E",
    "pink": "#DA627D",
    "peach": "#FCA17D",
    "sky": "#86BBD8",
    "teal": "#06969A",
    "navy": "#33658A",
    "red": "#D81E5B",
    "text": "#E0DEF4",
    "dark": "#2E3440"
  },
  "secondary_prompt": {
    "template": "<p:purple,transparent>\ue0b6</><,p:purple> > </><p:purple,transparent>\ue0b0</> ",
    "foreground": "p:text",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "<p:purple,transparent>\ue0b6</><,p:purple> {{ .Folder }} </><p:purple,transparent>\ue0b0</> ",
    "foreground": "p:text",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "tooltips": [
    {
      "properties": {
        "display_default": true
      },
      "leading_diamond": "\ue0b0",
      "trailing_diamond": "\ue0b4",
      "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "foreground": "p:text",
      "background": "p:teal",
      "type": "aws",
      "style": "diamond",
      "tips": [
        "aws"
      ]
    },
    {
      "properties": {
        "display_default": true
      },
      "leading_diamond": "\ue0b0",
      "trailing_diamond": "\ue0b4",
      "template": " \uebd8 {{ .Name }} ",
      "foreground": "p:text",
      "background": "p:sky",
      "type": "az",
      "style": "diamond",
      "tips": [
        "az"
      ]
    }
  ],
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " {{ if .SSHSession }}\ueba9 {{ end }}{{ .HostName }} ",
          "foreground": "p:text",
          "background": "p:purple",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "style": "agnoster"
          },
          "template": " \uea83 {{ path .Path .Location }} ",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b0",
          "background": "p:pink",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "foreground": "p:dark",
          "powerline_symbol": "\ue0b0",
          "background": "p:peach",
          "type": "git",
          "style": "powerline"
        },
        {
          "template": " \uf0e7 ",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b0",
          "background": "p:red",
          "type": "root",
          "style": "powerline"
        },
        {
          "properties": {
            "always_enabled": true
          },
          "leading_diamond": "<transparent,background>\ue0b0</>",
          "trailing_diamond": "\ue0b4",
          "template": " {{ if gt .Code 0 }}\uf00d{{ else }}\uf00c{{ end }} ",
          "foreground": "p:text",
          "background": "p:navy",
          "type": "status",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "display_mode": "files",
            "fetch_package_manager": false,
            "home_enabled": false
          },
          "template": "\ue718 ",
          "foreground": "p:sky",
          "background": "transparent",
          "type": "node",
          "style": "plain"
        },
        {
          "properties": {
            "fetch_version": false
          },
          "template": "\ue626 ",
          "foreground": "p:sky",
          "background": "transparent",
          "type": "go",
          "style": "plain"
        },
        {
          "properties": {
            "display_mode": "files",
            "fetch_version": false,
            "fetch_virtual_env": false
          },
          "template": "\ue235 ",
          "foreground": "p:sky",
          "background": "transparent",
          "type": "python",
          "style": "plain"
        },
        {
          "template": "in <p:sky><b>{{ .Name }}</b></> ",
          "foreground": "p:text",
          "background": "transparent",
          "type": "shell",
          "style": "plain"
        },
        {
          "template": "at <p:navy><b>{{ .CurrentDate | date \"15:04:05\" }}</b></>",
          "foreground": "p:text",
          "background": "transparent",
          "type": "time",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "template": "❯",
          "foreground": "p:pink",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
